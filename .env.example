# Copy this file to .env and replace the placeholder with your Groq key.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1600

# Optional: required only if YouTube blocks the cloud server as a bot.
# Use the base64-encoded contents of a Netscape/Mozilla cookies.txt file.
# Do not commit your real cookies or expose them to public users.
# YOUTUBE_COOKIES_B64=
# YOUTUBE_USER_AGENT=
